# ---------- Flask ----------
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# ---------- Security ----------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-change-me-before-deploying-0000000000
JWT_SECRET_KEY=dev-only-jwt-secret-change-me-before-deploying-0000000000

# ---------- Database ----------
# Using psycopg (v3) driver explicitly for SQLAlchemy 2.1+
DATABASE_URL=postgresql+psycopg://neondb_owner:npg_5KnsJVz4ebju@ep-fragrant-shape-baqq8nu7-pooler.c-8.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------- CORS ----------
# Comma-separated extra origins. The hardcoded dev origins
# (localhost:5173 / 127.0.0.1:5173 / :3000) are always allowed.
# Leave this empty for local dev.
FRONTEND_ORIGINS=

# ---------- Logging ----------
# DEBUG | INFO | WARNING | ERROR
# Leave blank to auto-pick (DEBUG in dev, INFO in production).
LOG_LEVEL=DEBUG
# Blank = human-readable colored (dev); "json" = one JSON per line (prod).
LOG_FORMAT=
# Optional rotating file. Comment out to log only to stdout.
# LOG_FILE=logs/chametu.log

