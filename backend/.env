# ============================================================
# Chametu backend — local development environment
# Do NOT commit this file. It is listed in backend/.gitignore.
# For the template to share with others, see backend/.env.example
# ============================================================

# ---------- Flask ----------
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# ---------- Security ----------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-change-me-before-deploying-0000000000
JWT_SECRET_KEY=dev-only-jwt-secret-change-me-before-deploying-0000000000

# ---------- Database ----------
DATABASE_URL=sqlite:///chametu.db

# ---------- CORS ----------
# Comma-separated extra origins. The hardcoded dev origins
# (localhost:5173 / 127.0.0.1:5173 / :3000) are always allowed.
# Leave this empty for local dev.
FRONTEND_ORIGINS=

# ---------- Logging ----------
# DEBUG | INFO | WARNING | ERROR
# Leave blank to auto-pick (DEBUG in dev, INFO in production).
LOG_LEVEL=DEBUG
# Blank = human-readable colored (dev); "json" = one JSON per line (prod).
LOG_FORMAT=
# Optional rotating file. Comment out to log only to stdout.
# LOG_FILE=logs/chametu.log
BREVO_API_KEY=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
BREVO_SENDER_EMAIL=mumod758@gmail.com
FRONTEND_URL=http://localhost:5173
INTASEND_PUBLISHABLE_KEY=ISPubKey_live_...
INTASEND_SECRET_KEY=ISSecretKey_live_...